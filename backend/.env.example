APP_NAME="AI Space Intelligence Platform"
APP_ENV="development"

# Local default. Replace with your Supabase PostgreSQL URL in production.
DATABASE_URL="sqlite:///./space_platform.db"

# Optional Supabase project values for future Supabase client usage.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Auth
JWT_SECRET_KEY="change-me"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# External APIs
NASA_API_KEY="DEMO_KEY"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODELS=""

# Frontend URL allowed by CORS.
FRONTEND_ORIGIN="http://localhost:5173"
